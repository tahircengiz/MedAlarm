<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup is DISABLED at the manifest level (android:allowBackup="false") for
    medical data privacy. This file exists only to satisfy the manifest reference; its
    rules don't take effect while allowBackup is false. Kept as a defense-in-depth
    against a future build accidentally re-enabling backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
