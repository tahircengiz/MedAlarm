<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Minimal AppCompat-style theme that hosts the Compose Activity.
        The real M3 theming happens inside Compose (Theme.kt).
    -->
    <style name="Theme.MedAlarm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
    </style>

    <!--
        The image cropper (CanHub) renders its Confirm (✓), rotate and Cancel (back)
        controls as ACTION BAR menu items. The app's own theme is NoActionBar, so the
        crop screen must use a theme WITH an action bar or those controls disappear and
        the user gets stuck. Teal accent matches the in-app palette. DayNight handles
        light/dark automatically.
    -->
    <style name="Theme.MedAlarm.Crop" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#00696C</item>
        <item name="colorPrimaryDark">#00504F</item>
        <item name="colorAccent">#00696C</item>
    </style>
</resources>
