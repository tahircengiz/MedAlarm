    <!-- Disclaimer (short form for onboarding; long form is shown on a dedicated screen) -->
    <string name="disclaimer_title">Disclaimer</string>
    <string name="disclaimer_accept">I have read and accept</string>
    <string name="disclaimer_short">MedAlarm is not a medical device and does not provide medical advice. You are responsible for taking your medication correctly. Notifications may be delayed or missed due to Android battery management; do not rely on this app alone for life-critical medication.</string>
    <string name="disclaimer_full_link">Read full disclaimer</string>
    <string name="disclaimer_full_body">MedAlarm is a free, open-source app written to help people take their medication on time. It is a social responsibility project. There are no ads in this app. No personal data is collected or transmitted to any server. No internet connection is required. Your data is stored only on your phone.\n\nMedAlarm is not a medical device. It does not provide medical advice, diagnosis, or treatment. This app is only a reminder tool. All responsibility for your medication lies with you:\n\n• Right medication, right dose, right time — you are responsible for the accuracy of the information you enter.\n• Your doctor\'s instructions always take priority. This app does not replace your doctor.\n• Notifications may not arrive. Android battery management, manufacturer optimizations, the phone being off, or the app being killed by the system can cause notifications to be delayed or missed entirely. Do not use this app as your only safety net.\n• Use a backup reminder for critical medications. For life-critical medications, do not rely on this app alone.\n• Consult your doctor for health concerns.\n\nThe developer cannot be held liable in any way for health issues, losses, or damages arising from missed or delayed notifications, or from data loss.\n\nBy using MedAlarm, you accept these terms.</string>

    <!-- Permission step copy -->
    <string name="permission_notification_title">Notification permission</string>
    <string name="permission_notification_rationale">Required so MedAlarm can show reminders. Without this, no alarm will be visible.</string>
    <string name="permission_exact_alarm_title">Exact alarm permission</string>
    <string name="permission_exact_alarm_rationale">Required so reminders fire at the exact minute they are scheduled, even while your phone is asleep.</string>
    <string name="permission_battery_title">Battery optimization exemption</string>
    <string name="permission_battery_rationale">Recommended. Without this, Android may delay or skip your reminders to save battery.</string>
    <string name="permission_oem_title">Background autostart</string>
    <string name="permission_oem_rationale">Recommended on Xiaomi, Huawei, Oppo, Vivo, Samsung and similar devices. Without it, the system may kill MedAlarm in the background and miss reminders.</string>
    <string name="permission_oem_confirm">I have enabled it</string>
