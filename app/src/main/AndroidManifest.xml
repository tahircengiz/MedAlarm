<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        BLOATWARE-FREE MANIFESTO ENFORCEMENT:
        The INTERNET permission is INTENTIONALLY ABSENT and must never be added.
        CI manifesto-guard fails the build if it appears as a real uses-permission tag.
        Without it, no library in this app can make a network call — by design.
    -->

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarms — MedAlarm qualifies as alarm-clock-class app per Play policy -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Battery optimization exemption (medical reminder use case justifies this) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reschedule alarms after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibration for notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service (for TTS playback during alarm if needed) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".MedAlarmApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedAlarm"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:theme="@style/Theme.MedAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            On-demand WorkManager initialization: MedAlarmApplication implements
            Configuration.Provider, so the default WorkManagerInitializer that
            androidx.startup would run MUST be removed, or WorkManager initializes
            twice. (lintVitalRelease enforces this.)
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            FileProvider for camera captures of medication box photos. The camera
            app writes into our cache via this authority; no CAMERA permission is
            needed because we delegate capture to the system camera app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Image cropper activity (CanHub/vanniktech). Its Confirm/rotate/Cancel
            controls live in the action bar menu; our app theme is NoActionBar, so
            override the crop activity's theme with one that HAS an action bar, or
            the user can't confirm or leave the crop screen.
        -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.MedAlarm.Crop"
            tools:replace="android:theme" />

        <!-- Alarm + boot/time-change broadcast receivers. -->
        <!--
            Receivers — concrete classes live in data/alarm/.
        -->
        <receiver
            android:name=".data.alarm.MedicationAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            tools:ignore="MissingClass" />

        <receiver
            android:name=".data.alarm.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false"
            tools:ignore="MissingClass" />

        <receiver
            android:name=".data.alarm.AutoSnoozeReceiver"
            android:enabled="true"
            android:exported="false"
            tools:ignore="MissingClass" />

        <receiver
            android:name=".data.alarm.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.alarm.TimeChangedReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
