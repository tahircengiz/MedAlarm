google-services.json

# Version control
vcs.xml

# Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Kotlin
.kotlin/

# macOS
.DS_Store

# Local env
.env
.env.local

# Signing keystores (never commit)
*.p12
keystore.properties
